bbcode_enabled = true
text = "[b]Privacy Policy[/b]

Last updated: December 1, 2025

[b]1. Information We Collect[/b]
This game stores your player name and high scores locally on your device and in our online leaderboard database.

[b]2. How We Use Your Information[/b]
• Player names are used to display on the leaderboard
• Scores are used for ranking purposes
• No personal information is collected

[b]3. Data Storage[/b]
• Local data is stored on your device
• Online leaderboard data is stored on Supabase servers
• We do not sell or share your data with third parties

[b]4. Your Rights[/b]
You can log off at any time to remove your local data. To remove your leaderboard entry, contact us.

[b]5. Contact[/b]
For questions about this policy, contact: your-email@example.com"
fit_content = true

[node name="OKButton" type="Button" parent="CenterContainer/Panel/VBoxContainer"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
theme_override_font_sizes/font_size = 18
